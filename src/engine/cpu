use std::collections::HashMap;

use crate::collector::{
    CpuTracker,
    read_process_cpu,
};

pub struct CpuEngine {
    tracker: CpuTracker,

    values: HashMap<u32, f32>,
}

impl CpuEngine {
    pub fn new() -> Self {
        Self {
            tracker: CpuTracker::new(),

            values: HashMap::new(),
        }
    }

    //----------------------------------------------------
    // Update
    //----------------------------------------------------

    pub fn update(
        &mut self,
        pid: u32,
    ) {

        let ticks =
            read_process_cpu(pid)
                .unwrap_or(0);

        let cpu =
            self.tracker.calculate(
                pid,
                ticks,
            );

        self.values.insert(
            pid,
            cpu,
        );

    }

    //----------------------------------------------------
    // Query
    //----------------------------------------------------

    pub fn value(
        &self,
        pid: u32,
    ) -> f32 {

        *self
            .values
            .get(&pid)
            .unwrap_or(&0.0)

    }

    //----------------------------------------------------
    // Cleanup
    //----------------------------------------------------

    pub fn cleanup(
        &mut self,
        active: &[u32],
    ) {

        self.values
            .retain(|pid, _| active.contains(pid));

        self.tracker.cleanup(active);

    }

    //----------------------------------------------------
    // Reset
    //----------------------------------------------------

    pub fn reset(
        &mut self,
    ) {

        self.values.clear();

    }
}
